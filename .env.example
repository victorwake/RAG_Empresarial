# =============================================================================
# SmartDocs AI — Variables de entorno de ejemplo
# Copiar a .env y completar los valores. NUNCA versionar .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=SmartDocs AI
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# Conexión usada por la API cuando corre fuera de Docker.
DATABASE_URL=postgresql+asyncpg://smartdocs:change-me@localhost:5432/smartdocs
# Conexión usada por la suite de tests (base distinta, nunca la de desarrollo).
DATABASE_TEST_URL=postgresql+asyncpg://smartdocs:change-me@localhost:5432/smartdocs_test
# Credenciales consumidas por el servicio `db` de Docker Compose.
POSTGRES_DB=smartdocs
POSTGRES_USER=smartdocs
POSTGRES_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Autenticación
# -----------------------------------------------------------------------------
# Secreto de firma JWT: mínimo 32 bytes aleatorios. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12

# -----------------------------------------------------------------------------
# Almacenamiento de archivos
# -----------------------------------------------------------------------------
FILE_STORAGE_ROOT=./data/uploads
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt

# -----------------------------------------------------------------------------
# Proveedores de IA (a partir de Etapa 5)
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Pipeline RAG (parámetros experimentales: calibrar en Etapa 5)
# -----------------------------------------------------------------------------
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
RETRIEVAL_TOP_K=6
# Umbral de referencia; se calibra con el dataset dorado antes de fijarlo.
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_MAX_CONTEXT_TOKENS=6000
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
PROMPT_VERSION=v1
