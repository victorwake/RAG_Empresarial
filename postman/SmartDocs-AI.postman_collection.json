							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Autentica con `organization_slug` + `email` + `password` y guarda `access_token` y `refresh_token` en variables de colección. Ejecutar primero: el resto de carpetas usa el token guardado. Credenciales inválidas devuelven 401 genérico."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"login devuelve 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var body = pm.response.json();",
									"pm.test(\"contiene tokens\", function () {",
									"    pm.expect(body.access_token).to.be.a(\"string\").and.not.empty;",
									"    pm.expect(body.refresh_token).to.be.a(\"string\").and.not.empty;",
									"});",
									"pm.collectionVariables.set(\"access_token\", body.access_token);",
									"pm.collectionVariables.set(\"refresh_token\", body.refresh_token);"
								]
							}
						}
					]
